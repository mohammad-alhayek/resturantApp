@model RestaurantStore.Shared.ProductDto.ResponseProductDto

@{
    ViewData["Title"] = "Edit Product";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Syne:wght@600;700&display=swap" rel="stylesheet" />

<style>
    .cr-wrap {
        font-family: 'DM Sans', sans-serif;
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .cr-back {
        display: inline-flex; align-items: center; gap: 6px;
        color: rgba(255,255,255,0.35); font-size: 0.85rem;
        text-decoration: none; margin-bottom: 1.4rem; transition: color .15s;
    }
    .cr-back:hover { color: rgba(255,255,255,0.7); }

    .cr-card {
        background: #0f1117;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px; overflow: hidden;
    }

    .cr-header {
        background: linear-gradient(135deg, #1a1c27, #13151f);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 1.8rem 2rem;
        display: flex; align-items: center; gap: 1rem;
    }
    .cr-header-icon {
        width: 46px; height: 46px; border-radius: 14px;
        background: rgba(108,99,255,0.12);
        border: 1px solid rgba(108,99,255,0.25);
        display: flex; align-items: center; justify-content: center;
    }
    .cr-header h2 {
        font-family: 'Syne', sans-serif; font-size: 1.2rem;
        font-weight: 700; color: #f0f0f5; margin: 0;
    }
    .cr-header p { color: rgba(255,255,255,0.3); font-size: 0.82rem; margin: 2px 0 0; }

    .cr-body { padding: 2rem; }

    .cr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .cr-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 1.2rem; }
    .cr-label {
        font-size: 11px; letter-spacing: .06em;
        color: rgba(255,255,255,0.35); text-transform: uppercase;
    }

    .cr-input, .cr-select, .cr-textarea {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px; color: #e8e8f0;
        padding: 10px 14px; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; transition: border-color .2s, background .2s;
        outline: none; width: 100%;
    }
    .cr-input::placeholder, .cr-textarea::placeholder { color: rgba(255,255,255,0.18); }
    .cr-input:focus, .cr-select:focus, .cr-textarea:focus {
        border-color: rgba(108,99,255,0.55);
        background: rgba(108,99,255,0.05); color: #fff;
    }
    .cr-select option { background: #1a1c27; }
    .cr-textarea { resize: vertical; min-height: 80px; }

    /* Image Upload */
    .img-upload-area {
        border: 2px dashed rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1.2rem;
        cursor: pointer;
        transition: border-color .2s;
    }
    .img-upload-area:hover { border-color: rgba(108,99,255,0.4); }

    .img-preview-box {
        width: 80px; height: 80px;
        border-radius: 10px;
        overflow: hidden;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .img-preview-box img {
        width: 100%; height: 100%; object-fit: cover;
    }
    .img-upload-text h4 {
        color: #e8e8f0; font-size: 0.9rem; font-weight: 500; margin: 0 0 4px;
    }
    .img-upload-text p {
        color: rgba(255,255,255,0.3); font-size: 0.78rem; margin: 0;
    }
    .img-upload-btn {
        margin-top: 8px;
        display: inline-block;
        padding: 6px 14px;
        background: rgba(108,99,255,0.15);
        border: 1px solid rgba(108,99,255,0.25);
        border-radius: 8px;
        color: #9d97ff;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .15s;
    }
    .img-upload-btn:hover { background: rgba(108,99,255,0.25); }

    .cr-footer {
        padding: 1.4rem 2rem;
        background: rgba(255,255,255,0.02);
        border-top: 1px solid rgba(255,255,255,0.05);
        display: flex; gap: 0.8rem;
        justify-content: flex-end; align-items: center;
    }

    .cr-error {
        background: rgba(220,53,69,0.1);
        border: 1px solid rgba(220,53,69,0.2);
        border-radius: 10px; color: #f87185;
        padding: 10px 16px; font-size: 0.88rem; margin-bottom: 1rem;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.45); border-radius: 10px;
        padding: 9px 20px; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; cursor: pointer; transition: all .15s;
        text-decoration: none; display: inline-block;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.06); color: #fff; }

    .btn-save {
        background: linear-gradient(135deg, #6c63ff, #5b54e8);
        color: #fff; border: none; border-radius: 10px;
        padding: 10px 26px; font-family: 'Syne', sans-serif;
        font-weight: 600; font-size: 0.9rem; cursor: pointer;
        box-shadow: 0 4px 20px rgba(108,99,255,0.3); transition: all .2s;
    }
    .btn-save:hover { transform: translateY(-1px); box-shadow: 0 6px 28px rgba(108,99,255,0.45); color: #fff; }
    .btn-save:active { transform: scale(0.98); }
</style>

<div class="cr-wrap">

    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="cr-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Products
    </a>

    <div class="cr-card">
        <div class="cr-header">
            <div class="cr-header-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6c63ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </div>
            <div>
                <h2>Edit Product</h2>
                <p>#@Model.Id — @Model.Name</p>
            </div>
        </div>

        <form asp-action="EditSave" asp-controller="Product" asp-area="Admin" method="post" enctype="multipart/form-data">
            <div class="cr-body">

                @if (ViewBag.Error != null)
                {
                    <div class="cr-error">⚠ @ViewBag.Error</div>
                }

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" value="@(Model.ImageUrl ?? "")" />>

                <div class="cr-grid">
                    <div class="cr-group">
                        <label class="cr-label">Product Name</label>
                        <input type="text" asp-for="Name" class="cr-input" placeholder="e.g. Cheeseburger" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Price</label>
                        <input type="number" asp-for="Price" class="cr-input" placeholder="0.00" step="0.01" />
                    </div>
                </div>

                <div class="cr-group">
                    <label class="cr-label">Description</label>
                    <textarea asp-for="Description" class="cr-textarea" placeholder="Brief description..."></textarea>
                </div>

                <div class="cr-group">
                    <label class="cr-label">Category</label>
                    <select asp-for="CategoryId" class="cr-select" asp-items="ViewBag.Categories">
                        <option value="">Select category</option>
                    </select>
                </div>

                @* Image Upload *@
                <div class="cr-group">
                    <label class="cr-label">Product Image</label>
                    <div class="img-upload-area" onclick="document.getElementById('imageInput').click()">
                        <div class="img-preview-box">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img id="imgPreview" src="https://localhost:7269@Model.ImageUrl" alt="preview" />
                            }
                            else
                            {
                                <img id="imgPreview" src="" alt="preview" style="display:none;" />
                                <svg id="imgPlaceholder" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            }
                        </div>
                        <div class="img-upload-text">
                            <h4>Click to change image</h4>
                            <p>PNG, JPG up to 5MB</p>
                            <span class="img-upload-btn">Browse file</span>
                        </div>
                    </div>
                    <input type="file" id="imageInput" name="image" accept="image/*" style="display:none;" />
                </div>

            </div>

            <div class="cr-footer">
                <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">💾 Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
    const input = document.getElementById('imageInput');
    const preview = document.getElementById('imgPreview');
    const placeholder = document.getElementById('imgPlaceholder');

    input.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            preview.src = e.target.result;
            preview.style.display = 'block';
            if (placeholder) placeholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
    });
</script>
