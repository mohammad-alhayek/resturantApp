@model RestaurantStore.Shared.CategoryDto.ResponseCategoryDto

@{
    ViewData["Title"] = "Edit Category";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    .cr-wrap {
        font-family: 'Inter', sans-serif;
        max-width: 560px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .cr-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.35);
        font-size: 0.85rem;
        text-decoration: none;
        margin-bottom: 1.4rem;
        transition: color .15s;
    }

        .cr-back:hover {
            color: rgba(255,255,255,0.7);
        }

    .card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header {
        background: #1a1a2e;
        padding: 1.8rem 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .card-header .icon {
            width: 44px;
            height: 44px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .card-header h2 {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0;
        }

        .card-header p {
            color: rgba(255,255,255,0.5);
            font-size: 0.82rem;
            margin-top: 2px;
        }

    .card-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: #444;
        margin-bottom: 0.4rem;
    }

    input[type="text"], textarea {
        width: 100%;
        padding: 0.7rem 1rem;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: #222;
        background: #fafafa;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

        input:focus, textarea:focus {
            border-color: #1a1a2e;
            box-shadow: 0 0 0 3px rgba(26,26,46,0.08);
            background: #fff;
        }

    textarea {
        resize: vertical;
        min-height: 90px;
    }

    .card-footer {
        padding: 1.2rem 2rem;
        background: #f9f9f9;
        border-top: 1px solid #f0f0f0;
        display: flex;
        gap: 0.8rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.65rem 1.6rem;
        border-radius: 10px;
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: #1a1a2e;
        color: #fff;
    }

        .btn-primary:hover {
            background: #2a2a4e;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(26,26,46,0.2);
            color: #fff;
        }

    .btn-secondary {
        background: #f0f0f0;
        color: #444;
    }

        .btn-secondary:hover {
            background: #e4e4e4;
            color: #444;
        }

    .cr-error {
        background: #fff0f0;
        border: 1px solid #ffd0d0;
        border-radius: 8px;
        color: #c00;
        padding: 10px 14px;
        font-size: 0.88rem;
        margin-bottom: 1rem;
    }
</style>

<div class="cr-wrap">

    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })" class="cr-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
        Back to Categories
    </a>

    <div class="card">
        <div class="card-header">
            <div class="icon">✏️</div>
            <div>
                <h2>Edit Category</h2>
                <p>#@Model.Id — @Model.Name</p>
            </div>
        </div>

        <form asp-action="EditSave" asp-controller="Category" asp-area="Admin" method="post">
            <div class="card-body">

                @if (ViewBag.Error != null)
                {
                    <div class="cr-error">⚠ @ViewBag.Error</div>
                }

                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="Name">Category Name</label>
                    <input type="text" asp-for="Name" placeholder="e.g. Burgers" />
                </div>

                <div class="form-group">
                    <label asp-for="Description">Description <span style="color:#aaa;font-weight:400;">(optional)</span></label>
                    <textarea asp-for="Description" placeholder="Brief description of this category..."></textarea>
                </div>

            </div>

            <div class="card-footer">
                <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">💾 Save Changes</button>
            </div>
        </form>
    </div>

</div>
