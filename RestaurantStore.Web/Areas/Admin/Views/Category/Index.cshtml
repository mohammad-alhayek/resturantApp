@model List<RestaurantStore.Shared.CategoryDto.ResponseCategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;1,400&family=Syne:wght@600;700&display=swap" rel="stylesheet" />

<style>
    .um-wrap {
        font-family: 'DM Sans', sans-serif;
        padding: 2rem 0;
    }

    .um-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.8rem;
    }

        .um-header h2 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #f0f0f5;
            margin: 0;
        }

        .um-header p {
            color: rgba(255,255,255,0.35);
            font-size: 0.85rem;
            margin: 2px 0 0;
        }

    .btn-add {
        background: linear-gradient(135deg, #6c63ff, #5b54e8);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 22px;
        font-family: 'Syne', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 20px rgba(108,99,255,0.3);
        transition: all .2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 28px rgba(108,99,255,0.45);
            color: #fff;
        }

    .um-alert {
        background: rgba(255,193,7,0.1);
        border: 1px solid rgba(255,193,7,0.25);
        border-radius: 10px;
        color: #ffc107;
        padding: 12px 16px;
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
    }

    .um-card {
        background: #0f1117;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
    }

    .um-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .um-table thead tr {
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .um-table thead th {
            padding: 14px 18px;
            color: rgba(255,255,255,0.35);
            font-size: 0.75rem;
            letter-spacing: .07em;
            text-transform: uppercase;
            font-weight: 500;
            text-align: left;
        }

        .um-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background .15s;
        }

            .um-table tbody tr:last-child {
                border-bottom: none;
            }

            .um-table tbody tr:hover {
                background: rgba(255,255,255,0.025);
            }

        .um-table tbody td {
            padding: 14px 18px;
            color: #d0d0e0;
            vertical-align: middle;
        }

  

    .cat-img-placeholder {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(108,99,255,0.1);
        border: 1px solid rgba(108,99,255,0.2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .cat-name-cell {
        display: flex;
        align-items: center;
    }

    .cat-name {
        font-weight: 500;
        color: #e8e8f0;
    }

    .cat-id {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.3);
    }

    .um-actions {
        display: flex;
        gap: 8px;
    }

    .um-btn {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .um-btn-edit {
        background: rgba(255,193,7,0.1);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.2);
    }

        .um-btn-edit:hover {
            background: rgba(255,193,7,0.2);
            color: #ffc107;
        }

    .um-btn-delete {
        background: rgba(220,53,69,0.1);
        color: #f87185;
        border: 1px solid rgba(220,53,69,0.2);
    }

        .um-btn-delete:hover {
            background: rgba(220,53,69,0.2);
            color: #f87185;
        }

    .um-empty {
        text-align: center;
        padding: 3rem;
        color: rgba(255,255,255,0.2);
    }

        .um-empty svg {
            margin-bottom: 1rem;
            opacity: .3;
        }
</style>

<div class="um-wrap">

    @if (ViewBag.Error != null)
    {
        <div class="um-alert">⚠ @ViewBag.Error</div>
    }

    <div class="um-header">
        <div>
            <h2>Categories</h2>
            <p>@Model?.Count category(s) found</p>
        </div>
        <a class="btn-add" href="@Url.Action("Create", "Category", new { area = "Admin" })">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add Category
        </a>
    </div>

    <div class="um-card">
        <table class="um-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category</th>
                    
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td>
                                <span class="cat-id">#@cat.Id</span>
                            </td>
                            <td>
                                <div class="cat-name-cell">
                                   
                                    <div class="cat-name">@cat.Name</div>
                                </div>
                            </td>
                            
                            <td>
                                <div class="um-actions">
                                    <a class="um-btn um-btn-edit"
                                       href="@Url.Action("Edit", "Category", new { area = "Admin", id = cat.Id })">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                        Edit
                                    </a>
                                    <a class="um-btn um-btn-delete"
                                       href="@Url.Action("Delete", "Category", new { area = "Admin", id = cat.Id })"
                                       onclick="return confirm('Delete @cat.Name?');">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">
                            <div class="um-empty">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                <p>No categories found</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
