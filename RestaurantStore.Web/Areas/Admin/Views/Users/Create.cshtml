@model RestaurantStore.Shared.UserDto.RegisterDto

@{
    ViewData["Title"] = "Create User";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Syne:wght@600;700&display=swap" rel="stylesheet" />

<style>
    .cr-wrap {
        font-family: 'DM Sans', sans-serif;
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .cr-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.35);
        font-size: 0.85rem;
        text-decoration: none;
        margin-bottom: 1.4rem;
        transition: color .15s;
    }

        .cr-back:hover {
            color: rgba(255,255,255,0.7);
        }

    .cr-card {
        background: #0f1117;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        overflow: hidden;
    }

    .cr-header {
        background: linear-gradient(135deg, #1a1c27, #13151f);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 1.8rem 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .cr-header-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: rgba(108,99,255,0.12);
        border: 1px solid rgba(108,99,255,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cr-header h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: #f0f0f5;
        margin: 0;
    }

    .cr-header p {
        color: rgba(255,255,255,0.3);
        font-size: 0.82rem;
        margin: 2px 0 0;
    }

    .cr-body {
        padding: 2rem;
    }

    .cr-section-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 1.6rem 0 1rem;
    }

        .cr-section-label::before, .cr-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,0.06);
        }

        .cr-section-label span {
            font-size: 10px;
            letter-spacing: .1em;
            color: rgba(255,255,255,0.2);
            text-transform: uppercase;
        }

    .cr-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .cr-grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
    }

    .cr-full {
        grid-column: 1 / -1;
    }

    .cr-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .cr-label {
        font-size: 11px;
        letter-spacing: .06em;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
    }

    .cr-input, .cr-select {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        color: #e8e8f0;
        padding: 10px 14px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        transition: border-color .2s, background .2s;
        outline: none;
        width: 100%;
    }

        .cr-input::placeholder {
            color: rgba(255,255,255,0.18);
        }

        .cr-input:focus, .cr-select:focus {
            border-color: rgba(108,99,255,0.55);
            background: rgba(108,99,255,0.05);
            color: #fff;
        }

        .cr-select option {
            background: #1a1c27;
        }

    .cr-footer {
        padding: 1.4rem 2rem;
        background: rgba(255,255,255,0.02);
        border-top: 1px solid rgba(255,255,255,0.05);
        display: flex;
        gap: 0.8rem;
        justify-content: flex-end;
        align-items: center;
    }

    .cr-error {
        background: rgba(220,53,69,0.1);
        border: 1px solid rgba(220,53,69,0.2);
        border-radius: 10px;
        color: #f87185;
        padding: 10px 16px;
        font-size: 0.88rem;
        margin-bottom: 1rem;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.45);
        border-radius: 10px;
        padding: 9px 20px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
        }

    .btn-save {
        background: linear-gradient(135deg, #6c63ff, #5b54e8);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 26px;
        font-family: 'Syne', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(108,99,255,0.3);
        transition: all .2s;
    }

        .btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 28px rgba(108,99,255,0.45);
            color: #fff;
        }

        .btn-save:active {
            transform: scale(0.98);
        }
</style>

<div class="cr-wrap">

    <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="cr-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
        Back to Users
    </a>

    <div class="cr-card">

        <div class="cr-header">
            <div class="cr-header-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6c63ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                    <line x1="12" y1="11" x2="12" y2="17" />
                    <line x1="9" y1="14" x2="15" y2="14" />
                </svg>
            </div>
            <div>
                <h2>Create New User</h2>
                <p>Fill in the details below to add a new account</p>
            </div>
        </div>

        <form asp-action="Create" asp-controller="Users" asp-area="Admin" method="post">
            <div class="cr-body">

                @if (ViewBag.Error != null)
                {
                    <div class="cr-error">⚠ @ViewBag.Error</div>
                }

                @* Account Info *@
                <div class="cr-grid">
                    <div class="cr-group">
                        <label class="cr-label">Full Name</label>
                        <input type="text" asp-for="FullName" class="cr-input" placeholder="Ahmad Khalil" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Username</label>
                        <input type="text" asp-for="Username" class="cr-input" placeholder="ahmad.khalil" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Email</label>
                        <input type="email" asp-for="Email" class="cr-input" placeholder="user@example.com" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Password</label>
                        <input type="password" asp-for="Password" class="cr-input" placeholder="••••••••" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Phone Number</label>
                        <input type="tel" asp-for="phonenumber" class="cr-input" placeholder="+962 7x xxx xxxx" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Role</label>
                        <select asp-for="Role" class="cr-select">
                            <option value="Staff">Staff</option>
                            <option value="User">User</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>

                @* Address *@
                <div class="cr-section-label"><span>Address</span></div>
                <div class="cr-grid-3">
                    <div class="cr-group">
                        <label class="cr-label">City</label>
                        <input type="text" asp-for="City" class="cr-input" placeholder="Amman" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">State</label>
                        <input type="text" asp-for="State" class="cr-input" placeholder="Irbid" />
                    </div>
                    <div class="cr-group">
                        <label class="cr-label">Street</label>
                        <input type="text" asp-for="Street" class="cr-input" placeholder="123 Main St" />
                    </div>
                </div>

            </div>

            <div class="cr-footer">
                <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">✓ Create User</button>
            </div>
        </form>

    </div>
</div>
