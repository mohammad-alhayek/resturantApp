@model List<RestaurantStore.Shared.UserDto.UserResponseDto>
@{
    ViewData["Title"] = "Users";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;1,400&family=Syne:wght@600;700&display=swap" rel="stylesheet" />

<style>
    .um-wrap {
        font-family: 'DM Sans', sans-serif;
        padding: 2rem 0;
    }

    .um-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.8rem;
    }

        .um-header h2 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #f0f0f5;
            margin: 0;
        }

        .um-header p {
            color: rgba(255,255,255,0.35);
            font-size: 0.85rem;
            margin: 2px 0 0;
        }

    .btn-add {
        background: linear-gradient(135deg, #6c63ff, #5b54e8);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 22px;
        font-family: 'Syne', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 20px rgba(108,99,255,0.3);
        transition: all .2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 28px rgba(108,99,255,0.45);
            color: #fff;
        }

    .um-alert {
        background: rgba(255,193,7,0.1);
        border: 1px solid rgba(255,193,7,0.25);
        border-radius: 10px;
        color: #ffc107;
        padding: 12px 16px;
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
    }

    .um-card {
        background: #0f1117;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
    }

    .um-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .um-table thead tr {
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .um-table thead th {
            padding: 14px 18px;
            color: rgba(255,255,255,0.35);
            font-size: 0.75rem;
            letter-spacing: .07em;
            text-transform: uppercase;
            font-weight: 500;
            text-align: left;
        }

        .um-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background .15s;
        }

            .um-table tbody tr:last-child {
                border-bottom: none;
            }

            .um-table tbody tr:hover {
                background: rgba(255,255,255,0.025);
            }

        .um-table tbody td {
            padding: 14px 18px;
            color: #d0d0e0;
            vertical-align: middle;
        }

    .um-avatar {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #6c63ff44, #5b54e844);
        border: 1px solid rgba(108,99,255,0.3);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Syne', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        color: #9d97ff;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .um-name-cell {
        display: flex;
        align-items: center;
    }

    .um-name {
        font-weight: 500;
        color: #e8e8f0;
    }

    .um-sub {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.3);
    }

    .um-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: .04em;
    }

        .um-badge.staff {
            background: rgba(108,99,255,0.15);
            color: #9d97ff;
            border: 1px solid rgba(108,99,255,0.25);
        }

        .um-badge.user {
            background: rgba(32,201,151,0.12);
            color: #20c997;
            border: 1px solid rgba(32,201,151,0.2);
        }

        .um-badge.manager {
            background: rgba(0,191,255,0.12);
            color: #00bfff;
            border: 1px solid rgba(0,191,255,0.2);
        }

        .um-badge.admin {
            background: rgba(255,165,0,0.12);
            color: #ffa500;
            border: 1px solid rgba(255,165,0,0.2);
        }

        .um-badge.other {
            background: rgba(255,255,255,0.07);
            color: rgba(255,255,255,0.45);
            border: 1px solid rgba(255,255,255,0.1);
        }

    .um-actions {
        display: flex;
        gap: 8px;
    }

    .um-btn {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .um-btn-edit {
        background: rgba(255,193,7,0.1);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.2);
    }

        .um-btn-edit:hover {
            background: rgba(255,193,7,0.2);
            color: #ffc107;
        }

    .um-btn-delete {
        background: rgba(220,53,69,0.1);
        color: #f87185;
        border: 1px solid rgba(220,53,69,0.2);
    }

        .um-btn-delete:hover {
            background: rgba(220,53,69,0.2);
            color: #f87185;
        }

    .um-empty {
        text-align: center;
        padding: 3rem;
        color: rgba(255,255,255,0.2);
    }

        .um-empty svg {
            margin-bottom: 1rem;
            opacity: .3;
        }
</style>

<div class="um-wrap">

    @if (ViewBag.Error != null)
    {
        <div class="um-alert">⚠ @ViewBag.Error</div>
    }

    <div class="um-header">
        <div>
            <h2>Users Management</h2>
            <p>@Model?.Count user(s) registered</p>
        </div>
        <a class="btn-add" href="@Url.Action("Create", "Users", new { area = "Admin" })">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Add User
        </a>
    </div>

    <div class="um-card">
        <table class="um-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        var initials = string.IsNullOrEmpty(user.FullName) ? "?" :
                        string.Join("", user.FullName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                        var roleClass = user.Role?.ToLower() == "admin" ? "admin" :
                        user.Role?.ToLower() == "user" ? "user" :
                        user.Role?.ToLower() == "staff" ? "staff" :
                        user.Role?.ToLower() == "manager" ? "manager" : "other";
                        <tr>
                            <td>
                                <div class="um-name-cell">
                                    <div class="um-avatar">@initials</div>
                                    <div>
                                        <div class="um-name">@user.FullName</div>
                                        <div class="um-sub">@@user.Username</div>
                                    </div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@(user.PhoneNumber ?? "—")</td>
                            <td>
                                <span class="um-badge @roleClass">@user.Role</span>
                            </td>
                            <td>
                                <div class="um-actions">
                                    <a class="um-btn um-btn-edit"
                                       href="@Url.Action("Edit", "Users", new { area = "Admin", id = user.Id })">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                        Edit
                                    </a>
                                    <a class="um-btn um-btn-delete"
                                       href="@Url.Action("Delete", "Users", new { area = "Admin", id = user.Id })"
                                       onclick="return confirm('Delete @user.Username?');">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="um-empty">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                <p>No users found</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
