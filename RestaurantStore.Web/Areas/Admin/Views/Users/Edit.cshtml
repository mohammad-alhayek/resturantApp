@model RestaurantStore.Shared.UserDto.UserResponseDto

@{
    ViewData["Title"] = "Edit User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit User</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f4f6f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 560px;
            overflow: hidden;
        }

        .card-header {
            background: #1a1a2e;
            padding: 1.8rem 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .card-header .icon {
                width: 44px;
                height: 44px;
                background: rgba(255,255,255,0.1);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
            }

            .card-header h2 {
                color: #ffffff;
                font-size: 1.2rem;
                font-weight: 600;
            }

            .card-header p {
                color: rgba(255,255,255,0.5);
                font-size: 0.82rem;
                margin-top: 2px;
            }

        .card-body {
            padding: 2rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: #444;
            margin-bottom: 0.4rem;
        }

        input[type="text"],
        input[type="email"],
        input[type="tel"],
        select {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            color: #222;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }

            input:focus, select:focus {
                border-color: #1a1a2e;
                box-shadow: 0 0 0 3px rgba(26,26,46,0.08);
                background: #fff;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card-footer {
            padding: 1.2rem 2rem;
            background: #f9f9f9;
            border-top: 1px solid #f0f0f0;
            display: flex;
            gap: 0.8rem;
            justify-content: flex-end;
        }

        .btn {
            padding: 0.65rem 1.6rem;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #1a1a2e;
            color: #fff;
        }

            .btn-primary:hover {
                background: #2a2a4e;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(26,26,46,0.2);
            }

        .btn-secondary {
            background: #f0f0f0;
            color: #444;
        }

            .btn-secondary:hover {
                background: #e4e4e4;
            }
    </style>
</head>
<body>

    <div class="card">
        <div class="card-header">
            <div class="icon">✏️</div>
            <div>
                <h2>Edit User</h2>
                <p>@Model.Email</p>
            </div>
        </div>

        <form asp-action="EditSave" asp-controller="Users" method="post">
            <div class="card-body">

                <input type="hidden" asp-for="Id" />

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FullName">Full Name</label>
                        <input type="text" asp-for="FullName" placeholder="Enter full name" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Username">Username</label>
                        <input type="text" asp-for="Username" placeholder="Enter username" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input type="email" asp-for="Email" placeholder="example@email.com" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <input type="tel" asp-for="PhoneNumber" placeholder="+1 234 567 890" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Role">Role</label>
                        <select asp-for="Role">
                            <option value="Staff">Staff</option>
                            <option value="User">User</option>
                            <option value="Manager">Manager</option>
                        </select>
                    </div>
                </div>

            </div>

            <div class="card-footer">
                <a asp-action="Index" asp-controller="Users" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">💾 Save Changes</button>
            </div>
        </form>
    </div>

</body>
</html>
